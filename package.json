{
  "name": "hivegraph",
  "version": "0.1.0",
  "description": "Turn one complex goal into a live, durable, validated agent swarm: plan, delegate, execute, validate, synthesize.",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/vercel-build.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "auth:migrate": "tsx scripts/migrate-auth.ts",
    "billing:migrate": "tsx scripts/migrate-billing.ts",
    "mcp:migrate": "tsx scripts/migrate-mcp.ts",
    "db:migrate": "pnpm auth:migrate && pnpm billing:migrate && pnpm mcp:migrate",
    "temporal:worker": "tsx src/temporal/worker.ts",
    "infra:up": "docker-compose up -d --wait",
    "infra:down": "docker-compose down",
    "infra:reset": "docker-compose down -v",
    "infra:logs": "docker-compose logs -f kafka redis postgres temporal telemetry",
    "infra:ps": "docker-compose ps",
    "infra:topic": "docker-compose exec kafka /opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9092 --describe --topic hivegraph.swarm.events",
    "infra:full": "docker-compose --profile app up -d --build --wait"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.142",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@next/env": "16.4.6",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@temporalio/activity": "^1.25.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/worker": "^1.25.0",
    "@temporalio/workflow": "^1.25.0",
    "ai": "^6.0.330",
    "animejs": "4.5.0",
    "better-auth": "^1.7.21",
    "cloudinary": "^2.11.0",
    "ioredis": "^5.11.1",
    "kafkajs": "^2.2.4",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "reactflow": "^11.11.4",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.6.2",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D3S-Gaurav/HiveGraph.git"
  }
}
